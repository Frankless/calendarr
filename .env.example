# ------------------------------------------------------------------
# Calendarr — copie ce fichier sous le nom .env puis remplis-le.
# Les clés API se trouvent :
#   Radarr / Sonarr : Settings > General > Security > API Key
#   Jellyfin        : Tableau de bord > Clés API > « + »
# Adresse : celle que tu tapes dans ton navigateur pour ouvrir le service
# (ex. http://192.168.1.20:7878). Si Calendarr tourne dans le même
# docker-compose que ton arr stack, tu peux utiliser le nom du conteneur
# (ex. http://radarr:7878).
# ------------------------------------------------------------------

RADARR_URL=http://192.168.1.20:7878
RADARR_API_KEY=

SONARR_URL=http://192.168.1.20:8989
SONARR_API_KEY=

JELLYFIN_URL=http://192.168.1.20:8096
JELLYFIN_API_KEY=
# Ton nom d'utilisateur Jellyfin (celui dont on lit l'historique « déjà vu »)
JELLYFIN_USER=

# Fuseau horaire
TZ=Europe/Brussels

# Facultatif : l'adresse publique de Calendarr si tu l'exposes sur Internet
# (ex. https://calendarr.mondomaine.be). Sert à fabriquer le lien du calendrier.
PUBLIC_URL=
